{
    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Run AI Code Agent Extension",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--disable-extensions",
                "--extensionDevelopmentPath=${workspaceFolder}/extension"
            ],
            "outFiles": [
                "${workspaceFolder}/extension/out/**/*.js"
            ]
        }
    ]
}